# Configuración del servidor JG Inmobiliaria
# Copia este archivo como .env y define tus propias credenciales antes de iniciar.

PORT=8080
DB_PATH=backend/jginmobiliaria.db

# Credenciales del Administrador (obligatorias, no dejar vacías)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_clave_segura

# Clave secreta para firmar sesiones (usa una cadena larga y aleatoria)
SESSION_SECRET=reemplaza_con_una_clave_aleatoria_larga

# Datos públicos de contacto del negocio
CONTACT_EMAIL=admin@jginmobiliaria.com
WHATSAPP_NUMBER=573114436916
WHATSAPP_DISPLAY=+57 3114436916

